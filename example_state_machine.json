{
    "config": [
        "Example State Machine - Each State Represents a Map",
        "Example Author"
    ],
    "StateMachine": [
        {
            "Key": "1",
            "campaign name": "Open World Combat V2",
            "campaign id": "2870702500",
            "mapname": "Standard Dynamic",
            "Transitions": [
                {
                    "to": "1",
                    "cond_expr": "player('ge', 2)",
                    "actuator_cmd": "delay:5s,start"
                },
                {
                    "to": "2",
                    "cond": "MissionStats('Complete')",
                    "actuator_cmd": "quit"
                },
                {
                    "to": "1",
                    "cond": "MissionStats('Failed')",
                    "actuator_cmd": "restart"
                },
                {
                    "to": "2",
                    "cond_expr": "elapsed('2h')",
                    "actuator_cmd": "quit"
                },
                {
                    "to": "1",
                    "cond_expr": "stage_equals('3-inmission') and player('lt', 1)",
                    "actuator_cmd": "delay:30s,restart"
                }
            ]
        },
        {
            "Key": "2",
            "campaign name": "Coop/Freeflight",
            "campaign id": "Coop/Freeflight",
            "mapname": "mp_navalMission2",
            "Transitions": [
                {
                    "to": "2",
                    "cond_expr": "player('ge', 2)",
                    "actuator_cmd": "delay:5s,start"
                },
                {
                    "to": "1",
                    "cond": "MissionStats('Complete')",
                    "actuator_cmd": "quit"
                },
                {
                    "to": "2",
                    "cond": "MissionStats('Failed')",
                    "actuator_cmd": "restart"
                },
                {
                    "to": "1",
                    "cond_expr": "elapsed('1.5h')",
                    "actuator_cmd": "quit"
                },
                {
                    "to": "2",
                    "cond_expr": "stage_equals('3-inmission') and player('lt', 1)",
                    "actuator_cmd": "delay:30s,restart"
                }
            ]
        }
    ]
}

